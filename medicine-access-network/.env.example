# Copy to .env.local for local development. Keep actual credentials out of Git.
NEXT_PUBLIC_APP_URL=https://medicine-access-network.vercel.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: required for account-free contact requests.
SUPABASE_SERVICE_ROLE_KEY=
# Optional independent secret for hashing contact rate-limit keys.
CONTACT_RATE_LIMIT_SECRET=

# Optional guide notification delivery. Configure a verified sender in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

NEXT_PUBLIC_PAYMENTS_ENABLED=false
