# Copy to .env.local for local development. Keep actual credentials out of Git.
NEXT_PUBLIC_APP_URL=https://thefacilitatornetwork.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: required for account-free contact requests.
SUPABASE_SERVICE_ROLE_KEY=
# Optional independent secret for hashing contact rate-limit keys.
CONTACT_RATE_LIMIT_SECRET=

# Server-only email delivery. Configure a verified sender in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Recipient for application-review alerts; does not grant admin access.
ADMIN_NOTIFICATION_EMAIL=

NEXT_PUBLIC_PAYMENTS_ENABLED=false
